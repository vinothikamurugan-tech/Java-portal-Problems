import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int a[] = new int[n];
        for(int i=0 ; i<n ; i++){
            a[i] = sc.nextInt();
        }
        int max = 0;
        int store = 0;
        boolean b[] = new boolean[n];
        for(int i=0 ; i<n ; i++){
            if(b[i]==false){
                int count = 0;
                for(int j=0 ; j<n ; j++){
                    if(a[i]==a[j]){
                        b[j] = true;
                        count++;
                    }
                }
                if(count>max){
                    max = count;
                    store = a[i];
                }
            }
        }
        System.out.println(store+" "+max);
    }
}
