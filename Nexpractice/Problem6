import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int a[] = new int[n];
        for(int i=0 ; i<n ; i++){
            a[i] = sc.nextInt();
        }
        int key = sc.nextInt();
        int count = 0;
        for(int i=0 ; i<n ; i++){
            if(a[i]>=key){
                System.out.print(a[i]+" ");
                count++;
            }
        }
        if(count==0){
            System.out.println(-1);
        }
    }
}
