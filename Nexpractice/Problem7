import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        long t = sc.nextLong();

        long days = t/(24*60*60);
        t = t%(24*60*60);

        long hours = t/(60*60);
        t = t%(60*60);

        long minutes = t/60;
        long sec = t%60; 

        System.out.println(days+" "+hours+" "+minutes+" "+sec);
    }
}
