import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        long a[] = new long[n];
        for(int i=0 ; i<n ; i++){
            a[i] = sc.nextLong();
        }
        int flag = 0;
        for(int i=0 ; i<n ; i++){
            long left = 0;
            long right = 0;
            for(int j=0 ; j<i ; j++){
                left = left+a[j];
            }
            for(int k=i+1 ; k<n ; k++){
                right = right+a[k];
            }
            if(left==right){
                System.out.print(i);
                flag = 1;
                break;
            }
        }
        if(flag==0){
            System.out.println("-1");
        }
    }
}
