import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int a[] = new int[n];
        for(int i=0 ; i<n ; i++){
            a[i] = sc.nextInt(); 
        }
        int min = a[0];
        int max = a[0];
        int minind = 0;
        int maxind = 0;
        for(int i=1 ; i<n ; i++){
            if(a[i]<min){
                min = a[i];
                minind = i;
            }else if(a[i]>max){
                max = a[i];
                maxind = i;
            }
        }
        a[minind] = max;
        a[maxind] = min;
        for(int i=0 ; i<n ; i++){
            System.out.print(a[i]+" ");
        }

    }
}
