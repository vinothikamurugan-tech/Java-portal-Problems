import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int b = n;
        int sum = 0;
        while(n!=0){
            int temp = n%10;
            int a = 1;
            while(temp>0){
                a = a*temp;
                temp--;
            }
            sum = sum+a;
            n/=10;
        }
        if(sum==b){
            System.out.println("Yes");
        }else{
            System.out.println("No");
        }
    }
}
