import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        int count = 0;
        while(n!=0){
            long temp = n%10;
            int cou = 0;
            for(long i=1 ; i<=temp ; i++){
                if(temp%i==0){
                    cou++;
                }
            }
            if(cou==2){
                count++;
            }
            n/=10;
        }
        System.out.println(count);
    }
}
