import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int a = n;
        int sum = 0;
        while(n!=0){
            int temp = n%10;
            sum = sum+temp;
            n/=10;
        }
        if(a%sum==0){
            System.out.println("Yes");
        }else{
            System.out.println("No");
        }
    }
}
