import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        int count = 0;
        while(n!=0){
            count++;
            n/=10;
        }
        long val = (long)Math.pow(10,count-1);
        System.out.println(val);
    }
}
