import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        while(n>=10){
            int sum = 0;
            while(n!=0){
                int temp = n%10;
                temp = temp*temp;
                sum = sum+temp;
                n/=10;
            }
            n = sum; 
        }
        if(n==1){
            System.out.println("Yes");
        }else{
            System.out.println("No");
        }
    }
}
