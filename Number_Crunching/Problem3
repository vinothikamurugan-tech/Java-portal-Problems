import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        long pro = 1;
        while(n!=0){
            long temp = n%10;
            pro*=temp;
            n/=10;
        }
        System.out.println(pro);
    }
}
