import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        long min = 0;
        while(n!=0){
            long temp = n%10;
            if(min<temp){
                min = temp;
            }
            n/=10;
        }
        System.out.println(min);
    }
}
