import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        String odd = "";
        String even = "";
        for(int i = 0; i<s.length(); i++){
            if((s.charAt(i)-'0')%2==1){
                odd = odd+s.charAt(i);
            }else if((s.charAt(i))%2==0){
                even = even+s.charAt(i);
            }
        }
        System.out.println(odd+even);
    }
}
