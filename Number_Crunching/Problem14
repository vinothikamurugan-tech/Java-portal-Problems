import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        long a = n;
        long pro = 0;
        while(n!=0){
            long temp = n%10;
            pro = pro*10+temp;
            n/=10;
        }
        if(a==pro){
            System.out.println("Yes");
        }else{
            System.out.println("No");
        }
    }
}
