import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum = 0;
        for(int i=1 ; i<6 ; i++){
            int temp = n%10;   
            if(i==2 || i==5){
                sum = sum+temp;
            }
            n/=10;
        }
        System.out.println(sum);
    }
}
