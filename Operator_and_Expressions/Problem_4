import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int hun = 0;
        int fif = 0;
        int twen = 0;
        int ten = 0;
        int five = 0;
        int two = 0;
        int one = 0;
        while(n>0){
            if(n>=100){
                hun++;
                n=n-100;
            }else if(n>=50){
                fif++;
                n=n-50;
            }else if(n>=20){
                twen++;
                n=n-20;
            }else if(n>=10){
                ten++;
                n=n-10;
            }else if(n>=5){
                five++;
                n=n-5;
            }else if(n>=2){
                two++;
                n=n-2;
            }else if(n>=1){
                one++;
                n=n-1;
            }
        }
        System.out.println(hun+" Note(s) of 100.00");
        System.out.println(fif+" Note(s) of 50.00");
        System.out.println(twen+" Note(s) of 20.00");
        System.out.println(ten+" Note(s) of 10.00");
        System.out.println(five+" Note(s) of 5.00");
        System.out.println(two+" Note(s) of 2.00");
        System.out.println(one+" Note(s) of 1.00");
    }
}
