import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int yr = n/365;
        int yr1 = n%365;
        int week = yr1/7;
        int days = yr1%7; 
        System.out.println("Years: "+yr);
        System.out.println("Weeks: "+week);
        System.out.println("Days: "+days);
        
    }
}
