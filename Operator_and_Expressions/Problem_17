import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum = 0 , i=1;
        while(i<=3){
            int temp = n%10; 
            sum = sum+temp;
            n/=10;   
            i++;
        }
        System.out.println(sum);
    }
}
